---
/**
 * Sunny: the floating assistant available on every page.
 * The launcher opens a chat panel (a bottom sheet on phones). The conversation
 * logic lives in scripts/sunny-chat.ts; open/close behaviour in scripts/sunny.ts.
 */
---
<div class="sunny-dock" id="sunny-dock">
  <div class="sn-teaser" id="sn-teaser" hidden>
    <button class="sn-teaser-x" type="button" id="sn-teaser-x" aria-label="Dismiss">×</button>
    <p class="sn-teaser-h"><span class="sn-dot" aria-hidden="true"></span><b>Ask Sunny about Rohit</b><span class="tag">AI</span></p>
    <div class="sn-prompts">
      <button type="button" data-ask="What does Rohit work on?">What does Rohit work on?</button>
      <button type="button" data-ask="What's his tech stack?">What's his tech stack?</button>
      <button type="button" data-ask="I'm hiring for a position">I'm hiring. Pass it to Rohit</button>
    </div>
  </div>

  <section class="card sunny" id="sunny" role="dialog" aria-modal="false" aria-labelledby="sn-title" hidden>
    <div class="sn-head">
      <span class="sn-av" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="#5a3500" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg></span>
      <div><b id="sn-title">Sunny <span class="tag">AI</span></b><small><i></i>Answers from Rohit's portfolio</small></div>
      <button class="sn-close" type="button" id="sn-close" aria-label="Close chat"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
    </div>
    <div class="sn-log" id="sn-log" aria-live="polite"></div>
    <div>
      <form class="sn-form" id="sn-form" autocomplete="on">
        <label class="sr" for="sn-in">Message Sunny</label>
        <textarea id="sn-in" rows="1" placeholder="Ask anything about Rohit…"></textarea>
        <button type="submit" id="sn-send" aria-label="Send"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></button>
      </form>
      <p class="sn-note">Sunny answers from this portfolio. Details you share are sent to Rohit.</p>
    </div>
  </section>

  <button class="sn-launch" type="button" id="sn-launch" aria-controls="sunny" aria-expanded="false">
    <span class="sn-orb" aria-hidden="true">
      <span class="ray"></span>
      <svg class="chat" viewBox="0 0 24 24" fill="none" stroke="#4a2c00" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 6.5h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-7l-4 3v-3H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z" /><path d="M8.5 12h.01M12 12h.01M15.5 12h.01" /></svg>
    </span>
    <span class="sn-label"><b>Ask Sunny</b><small>about Rohit</small></span>
    <span class="sn-badge" id="sn-badge" aria-hidden="true">1</span>
    <span class="sr">Open chat with Sunny, an assistant that answers questions about Rohit</span>
  </button>
</div>

<!-- Static copy of Sunny's fields so Netlify can detect the form at deploy time. -->
<form name="sunny" data-netlify="true" netlify-honeypot="bot-field" hidden aria-hidden="true">
  <input name="bot-field" /><input name="status" /><input name="intent" /><input name="details" /><input name="fit" /><input name="name" /><input name="email" /><input name="company" /><textarea name="transcript"></textarea><textarea name="visit"></textarea>
</form>
