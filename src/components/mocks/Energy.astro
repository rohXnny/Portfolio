---
// Product mock: an abstract view of the energy project's UI.
---
<div class="mock m-energy">
  <div class="bar"><i></i><i></i><i></i><b>Fuel network</b></div>
  <div class="body">
    <svg class="net" viewBox="0 0 220 140" aria-hidden="true">
      <g stroke="#F29A7B" stroke-width="1.6" fill="none" class="flow"><path d="M50 70 L120 25"/><path d="M50 70 L170 60"/><path d="M50 70 L130 110"/><path d="M170 60 L205 118"/></g>
      <rect x="20" y="55" width="30" height="30" rx="4" fill="#e0633b"/><path d="M28 63h14v14H28z" fill="none" stroke="#1a110c" stroke-width="2"/>
      <g fill="#1a110c" stroke="#F29A7B" stroke-width="2"><circle cx="120" cy="25" r="8"/><circle cx="170" cy="60" r="8"/><circle cx="130" cy="110" r="8"/><circle cx="205" cy="118" r="8"/></g>
    </svg>
    <div class="tanks">
      <div class="tank"><span>Unleaded</span><div class="lvl"><i style="--a:45%;--b:80%"></i></div></div>
      <div class="tank"><span>Diesel</span><div class="lvl"><i style="--a:70%;--b:40%"></i></div></div>
      <div class="tank"><span>Premium</span><div class="lvl"><i style="--a:30%;--b:60%"></i></div></div>
    </div>
  </div>
</div>
