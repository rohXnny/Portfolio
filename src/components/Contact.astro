---
/** Contact: direct details, the lead form and Sunny. Both forms post to Netlify Forms. */
import { site } from "../data/site";
---
<section class="page" id="contact" data-page="contact" hidden>
  <div class="col">
    <header class="sh">
      <div class="sh-meta"><span class="k">Contact</span><span class="rule"></span><span>Email · phone · form · chat</span></div>
      <h2 class="sh-title">Contact</h2>
      <p class="sh-lead">Here's how to reach me. Leave your details too, and I'll get back to you.</p>
    </header>

    <div class="contact-grid">
      <div class="contact-side">
      <div class="reach">
        <button class="copy" type="button" data-v={site.email} data-l="Email"><span class="k">Email</span><span class="v">{site.email}</span><span class="go">Copy</span></button>
        <button class="copy" type="button" data-v={site.phone} data-l="Phone"><span class="k">Phone</span><span class="v">{site.phone}</span><span class="go">Copy</span></button>
      </div>

      <button class="ask-sunny" type="button" data-open-sunny>
        <span class="sn-av" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="#5a3500" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg></span>
        <span class="t"><b>Prefer to chat?</b><span>Sunny asks a few quick questions and passes them to me.</span></span>
        <span class="kbd" aria-hidden="true">/</span>
      </button>
      </div>

      <div class="card leave" id="leave">
        <h3>Leave your details</h3>
        <p>Hiring or have a project in mind? Leave your details and I'll reach out to you.</p>
        <form id="lead" name="lead" data-netlify="true" netlify-honeypot="bot-field" novalidate>
          <input type="hidden" name="form-name" value="lead" />
          <p hidden><label>Leave empty<input name="bot-field" /></label></p>
          <input type="hidden" name="visit" id="l-visit" />
          <label>Name<input id="l-name" name="name" autocomplete="name" required /></label>
          <label>Company<input id="l-company" name="company" autocomplete="organization" /></label>
          <label class="full">Email<input id="l-email" name="email" type="email" autocomplete="email" required /></label>
          <label class="full">You are a
            <select id="l-role" name="role"><option>Recruiter</option><option>Hiring manager</option><option>Engineer</option><option>Founder</option><option>Other</option></select>
          </label>
          <label class="full">Message (optional)<textarea id="l-msg" name="message" placeholder="The role, the team, or a good time to talk"></textarea></label>
          <div class="err" id="l-err" hidden></div>
          <button class="btn btn-primary" type="submit">Send my details <span class="arr" aria-hidden="true">→</span></button>
        </form>
      </div>
    </div>

  </div>
</section>
